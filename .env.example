# Stellar network configuration (public env vars — safe to expose to the browser)
# These default to Stellar Testnet. Copy this file to `.env.local` to override.

# Horizon testnet endpoint
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase — must match the network above.
# Testnet: "Test SDF Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Friendbot funding endpoint (testnet only)
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
